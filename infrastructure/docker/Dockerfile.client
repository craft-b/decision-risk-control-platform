# Dockerfile.client — React frontend served by Nginx
# Multi-stage: Node builds the Vite bundle, Nginx serves it.
# Nginx proxies /api/* to the Node server container.

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (layer-cached unless package.json changes)
COPY package*.json ./
RUN npm ci --ignore-scripts

# Copy source
COPY . .

# Build Vite client only (skip server esbuild — not needed here)
# VITE_API_URL is intentionally empty: Nginx proxies /api → server:5000
ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL

RUN npx vite build

# ── Stage 2: Serve ────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY --from=builder /app/dist/public /usr/share/nginx/html
COPY infrastructure/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
